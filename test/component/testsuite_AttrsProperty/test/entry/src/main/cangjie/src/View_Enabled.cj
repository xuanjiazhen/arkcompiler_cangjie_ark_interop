@Entry
@Component
class View_Enabled {
    func build() {
        Flex(FlexParams(justifyContent: FlexAlign.SpaceAround)) {
            // 点击没有反应
            Button("disable").id("button").enabled(false).backgroundColor(0x317aff).opacity(0.4)
            Button("enable").backgroundColor(0x317aff)
        }.width(100.percent).padding(top: 5)
    }
}
