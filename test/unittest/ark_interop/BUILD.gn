import("//build/test.gni")

module_output_path = "cangjie_ark_interop/cangjie_ark_interop"

ohos_unittest("test_ark_interop") {
  module_out_path = module_output_path
  part_name = "cangjie_ark_interop"
  subsystem_name = "arkcompiler"

  cflags = [ "-g3" ]

  sources = [
    "test_ark_interop.cpp",
    "test_ark_interop_coverage.cpp",
    "test_ark_interop_common.cpp",
  ]

  external_deps = [
    "napi:ace_napi",
    "napi:ark_interop",
    "ets_runtime:libark_jsruntime",
    "eventhandler:libeventhandler",
    "hilog:libhilog",
    "libuv:uv",
    "c_utils:utils",
  ]

  defines = []
  if (use_clang_coverage) {
    defines += [ "CLANG_COVERAGE" ]
  }
}

ohos_unittest("test_ffi_data") {
  module_out_path = module_output_path
  part_name = "cangjie_ark_interop"
  subsystem_name = "arkcompiler"

  cflags = [ "-g3" ]

  sources = [ "test_ffi_data.cpp" ]

  external_deps = [
    "napi:cj_bind_ffi",
    "napi:cj_bind_native",
    "hilog:libhilog",
    "libuv:uv",
    "c_utils:utils",
  ]

  defines = []
  if (use_clang_coverage) {
    defines += [ "CLANG_COVERAGE" ]
  }
}

ohos_unittest("test_cj_backtrace") {
  module_out_path = module_output_path
  part_name = "cangjie_ark_interop"
  subsystem_name = "arkcompiler"

  cflags = [ "-g3" ]

  sources = [ "test_cj_backtrace.cpp" ]

  external_deps = [ "napi:cj_backtrace" ]

  defines = []
  if (use_clang_coverage) {
    defines += [ "CLANG_COVERAGE" ]
  }
}

group("ark_interop_native_unittest") {
  testonly = true
  deps = [
    ":test_ark_interop",
    ":test_ffi_data",
  ]
  if (is_ohos && (current_cpu == "arm64" || current_cpu == "x86_64")) {
    deps += [ ":test_cj_backtrace" ]
  }
}
