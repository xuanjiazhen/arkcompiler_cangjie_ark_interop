            abortSession(verifyHandle, HuksOptions([], Option.None))
            @Assert(verify.isEmpty(), false)
            deleteKeyItem("keyAlias1", HuksOptions.NONE)
            @Expect("assertion#6137: not throw", "would throw exception")
        } catch (e: BusinessException) {
