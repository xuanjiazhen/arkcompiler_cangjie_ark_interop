package ohos_app_cangjie_entry

internal import std.unittest.*
import std.unittest.testmacro.*
internal import kit.UniversalKeystoreKit.*
import std.unittest.testmacro.*
import std.unittest.*
import std.unittest.common.*
import std.unittest.testmacro.*
import ohos.base.*

@Test
class Test_SecurityHuks_Enum {
    /*
    * @tc.number    : Sub_Cangjie_UniversalKeystoreKit_Test_SecurityHuks_Enum_0100
    * @tc.name      : test_tags_parse
    * @tc.desc      : test UniversalKeystoreKit HuksTag
    * @tc.size      : MediumTest
    * @tc.type      : Function
    * @tc.level     : Level 0
    */
    @TestCase
    @Tag[APILevel15, TestLevel0]
    func test_tags_parse() {
        let invalid = HuksTag.parse(0x0)
        @Expect(invalid.getValue() == (HuksTag.HUKS_TAG_INVALID).getValue())
        let algorithm = HuksTag.parse(0x20000001)
        @Expect(algorithm.getValue() == (HuksTag.HUKS_TAG_ALGORITHM).getValue())
        let purpose = HuksTag.parse(0x20000002)
        @Expect(purpose.getValue() == (HuksTag.HUKS_TAG_PURPOSE).getValue())
        let keySize = HuksTag.parse(0x20000003)
        @Expect(keySize.getValue() == (HuksTag.HUKS_TAG_KEY_SIZE).getValue())
        let digest = HuksTag.parse(0x20000004)
        @Expect(digest.getValue() == (HuksTag.HUKS_TAG_DIGEST).getValue())
        let padding = HuksTag.parse(0x20000005)
        @Expect(padding.getValue() == (HuksTag.HUKS_TAG_PADDING).getValue())
        let blockMode = HuksTag.parse(0x20000006)
        @Expect(blockMode.getValue() == (HuksTag.HUKS_TAG_BLOCK_MODE).getValue())
        let keyType = HuksTag.parse(0x20000007)
        let associatedData = HuksTag.parse(0x50000008)
        @Expect(associatedData.getValue() == (HuksTag.HUKS_TAG_ASSOCIATED_DATA).getValue())
        let nonce = HuksTag.parse(0x50000009)
        @Expect(nonce.getValue() == (HuksTag.HUKS_TAG_NONCE).getValue())
        let iv = HuksTag.parse(0x5000000a)
        @Expect(iv.getValue() == (HuksTag.HUKS_TAG_IV).getValue())
        let info = HuksTag.parse(0x5000000b)
        @Expect(info.getValue() == (HuksTag.HUKS_TAG_INFO).getValue())
        let salt = HuksTag.parse(0x5000000c)
        @Expect(salt.getValue() == (HuksTag.HUKS_TAG_SALT).getValue())
        let pwd = HuksTag.parse(0x5000000d)
        @Expect(pwd.getValue() == (HuksTag.HUKS_TAG_PWD).getValue())
        let iteration = HuksTag.parse(0x2000000e)
        @Expect(iteration.getValue() == (HuksTag.HUKS_TAG_ITERATION).getValue())
        let keyGenerateType = HuksTag.parse(0x2000000f)
        @Expect(keyGenerateType.getValue() == (HuksTag.HUKS_TAG_KEY_GENERATE_TYPE).getValue())
        let deriveMainKey = HuksTag.parse(0x50000010)
        @Expect(deriveMainKey.getValue() == (HuksTag.HUKS_TAG_DERIVE_MAIN_KEY).getValue())
        let deriveFactor = HuksTag.parse(0x50000011)
        @Expect(deriveFactor.getValue() == (HuksTag.HUKS_TAG_DERIVE_FACTOR).getValue())
        let deriveAlg = HuksTag.parse(0x20000012)
        @Expect(deriveAlg.getValue() == (HuksTag.HUKS_TAG_DERIVE_ALG).getValue())
        let agreeAlg = HuksTag.parse(0x20000013)
        @Expect(agreeAlg.getValue() == (HuksTag.HUKS_TAG_AGREE_ALG).getValue())
        let agreePublicKeyIsKeyAlias = HuksTag.parse(0x40000014)
        @Expect(agreePublicKeyIsKeyAlias.getValue() == (HuksTag.HUKS_TAG_AGREE_PUBLIC_KEY_IS_KEY_ALIAS).getValue())
        let agreePrivateKeyAlias = HuksTag.parse(0x50000015)
        @Expect(agreePrivateKeyAlias.getValue() == (HuksTag.HUKS_TAG_AGREE_PRIVATE_KEY_ALIAS).getValue())
        let agreePublicKey = HuksTag.parse(0x50000016)
        @Expect(agreePublicKey.getValue() == (HuksTag.HUKS_TAG_AGREE_PUBLIC_KEY).getValue())
        let keyAlias = HuksTag.parse(0x50000017)
        @Expect(keyAlias.getValue() == (HuksTag.HUKS_TAG_KEY_ALIAS).getValue())
        let deriveKeySize = HuksTag.parse(0x20000018)
        @Expect(deriveKeySize.getValue() == (HuksTag.HUKS_TAG_DERIVE_KEY_SIZE).getValue())
        let importKeyType = HuksTag.parse(0x20000019)
        @Expect(importKeyType.getValue() == (HuksTag.HUKS_TAG_IMPORT_KEY_TYPE).getValue())
        let unwrapAlgorithmSuite = HuksTag.parse(0x2000001a)
        @Expect(unwrapAlgorithmSuite.getValue() == (HuksTag.HUKS_TAG_UNWRAP_ALGORITHM_SUITE).getValue())
        let derivedAgreedKeyStorageFlag = HuksTag.parse(0x2000001d)
        @Expect(derivedAgreedKeyStorageFlag.getValue() == (HuksTag.HUKS_TAG_DERIVED_AGREED_KEY_STORAGE_FLAG).getValue())
        let rsaPssSaltLenType = HuksTag.parse(0x2000001e)
        @Expect(rsaPssSaltLenType.getValue() == (HuksTag.HUKS_TAG_RSA_PSS_SALT_LEN_TYPE).getValue())
        let activeDateTime = HuksTag.parse(0x300000c9)
        @Expect(activeDateTime.getValue() == (HuksTag.HUKS_TAG_ACTIVE_DATETIME).getValue())
        let originationExpireDateTime = HuksTag.parse(0x300000ca)
        @Expect(originationExpireDateTime.getValue() == (HuksTag.HUKS_TAG_ORIGINATION_EXPIRE_DATETIME).getValue())
        let usageExpireDateTime = HuksTag.parse(0x300000cb)
        @Expect(usageExpireDateTime.getValue() == (HuksTag.HUKS_TAG_USAGE_EXPIRE_DATETIME).getValue())
        let creationDateTime = HuksTag.parse(0x300000cc)
        @Expect(creationDateTime.getValue() == (HuksTag.HUKS_TAG_CREATION_DATETIME).getValue())
        let allUsers = HuksTag.parse(0x4000012d)
        @Expect(allUsers.getValue() == (HuksTag.HUKS_TAG_ALL_USERS).getValue())
        let userId = HuksTag.parse(0x2000012e)
        @Expect(userId.getValue() == (HuksTag.HUKS_TAG_USER_ID).getValue())
        let noAuthRequired = HuksTag.parse(0x4000012f)
        @Expect(noAuthRequired.getValue() == (HuksTag.HUKS_TAG_NO_AUTH_REQUIRED).getValue())
        let userAuthType = HuksTag.parse(0x20000130)
        @Expect(userAuthType.getValue() == (HuksTag.HUKS_TAG_USER_AUTH_TYPE).getValue())
        let authTimeout = HuksTag.parse(0x20000131)
        @Expect(authTimeout.getValue() == (HuksTag.HUKS_TAG_AUTH_TIMEOUT).getValue())
        let authToken = HuksTag.parse(0x50000132)
        @Expect(authToken.getValue() == (HuksTag.HUKS_TAG_AUTH_TOKEN).getValue())
        let keyAuthAccessType = HuksTag.parse(0x20000133)
        @Expect(keyAuthAccessType.getValue() == (HuksTag.HUKS_TAG_KEY_AUTH_ACCESS_TYPE).getValue())
        let keySecureSignType = HuksTag.parse(0x20000134)
        @Expect(keySecureSignType.getValue() == (HuksTag.HUKS_TAG_KEY_SECURE_SIGN_TYPE).getValue())
        let challengeType = HuksTag.parse(0x20000135)
        @Expect(challengeType.getValue() == (HuksTag.HUKS_TAG_CHALLENGE_TYPE).getValue())
        let challengePos = HuksTag.parse(0x20000136)
        @Expect(challengePos.getValue() == (HuksTag.HUKS_TAG_CHALLENGE_POS).getValue())
        let keyAuthPurpose = HuksTag.parse(0x20000137)
        @Expect(keyAuthPurpose.getValue() == (HuksTag.HUKS_TAG_KEY_AUTH_PURPOSE).getValue())
        let attestationChallenge = HuksTag.parse(0x500001f5)
        @Expect(attestationChallenge.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_CHALLENGE).getValue())
        let attestationApplicationId = HuksTag.parse(0x500001f6)
        @Expect(attestationApplicationId.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_APPLICATION_ID).getValue())
        let attestationIdBrand = HuksTag.parse(0x500001f7)
        @Expect(attestationIdBrand.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_BRAND).getValue())
        let attestationIdDevice = HuksTag.parse(0x500001f8)
        @Expect(attestationIdDevice.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_DEVICE).getValue())
        let attestationIdProduct = HuksTag.parse(0x500001f9)
        @Expect(attestationIdProduct.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_PRODUCT).getValue())
        let attestationIdSerial = HuksTag.parse(0x500001fa)
        @Expect(attestationIdSerial.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_SERIAL).getValue())
        let attestationIdImei = HuksTag.parse(0x500001fb)
        @Expect(attestationIdImei.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_IMEI).getValue())
        let attestationIdMeid = HuksTag.parse(0x500001fc)
        @Expect(attestationIdMeid.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_MEID).getValue())
        let attestationIdManufacturer = HuksTag.parse(0x500001fd)
        @Expect(attestationIdManufacturer.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_MANUFACTURER).getValue())
        let attestationIdModel = HuksTag.parse(0x500001fe)
        @Expect(attestationIdModel.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_MODEL).getValue())
        let attestationIdAlias = HuksTag.parse(0x500001ff)
        @Expect(attestationIdAlias.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_ALIAS).getValue())
        let attestationIdSocId = HuksTag.parse(0x50000200)
        @Expect(attestationIdSocId.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_SOCID).getValue())
        let attestationIdUdid = HuksTag.parse(0x50000201)
        @Expect(attestationIdUdid.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_UDID).getValue())
        let attestationIdSecLevel = HuksTag.parse(0x50000202)
        @Expect(attestationIdSecLevel.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_SEC_LEVEL_INFO).getValue())
        let attestationIdVersionInfo = HuksTag.parse(0x50000203)
        @Expect(attestationIdVersionInfo.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_ID_VERSION_INFO).getValue())
        let attestationBase64 = HuksTag.parse(0x40000204)
        @Expect(attestationBase64.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_BASE64).getValue())
        let attestationMode = HuksTag.parse(0x20000205)
        @Expect(attestationMode.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_MODE).getValue())
        let attestationApplicationIdType = HuksTag.parse(0x20000206)
        @Expect(attestationApplicationIdType.getValue() == (HuksTag.HUKS_TAG_ATTESTATION_APPLICATION_ID_TYPE).getValue())
        let isKeyAlias = HuksTag.parse(0x400003e9)
        @Expect(isKeyAlias.getValue() == (HuksTag.HUKS_TAG_IS_KEY_ALIAS).getValue())
        let keyStorageFlag = HuksTag.parse(0x200003ea)
        @Expect(keyStorageFlag.getValue() == (HuksTag.HUKS_TAG_KEY_STORAGE_FLAG).getValue())
        let isAllowedWrap = HuksTag.parse(0x400003eb)
        @Expect(isAllowedWrap.getValue() == (HuksTag.HUKS_TAG_IS_ALLOWED_WRAP).getValue())
        let keyWrapType = HuksTag.parse(0x200003ec)
        @Expect(keyWrapType.getValue() == (HuksTag.HUKS_TAG_KEY_WRAP_TYPE).getValue())
        let keyAuthId = HuksTag.parse(0x500003ed)
        @Expect(keyAuthId.getValue() == (HuksTag.HUKS_TAG_KEY_AUTH_ID).getValue())
        let keyRole = HuksTag.parse(0x200003ee)
        @Expect(keyRole.getValue() == (HuksTag.HUKS_TAG_KEY_ROLE).getValue())
        let keyFlag = HuksTag.parse(0x200003ef)
        @Expect(keyFlag.getValue() == (HuksTag.HUKS_TAG_KEY_FLAG).getValue())
        let isAsynchronous = HuksTag.parse(0x200003f0)
        @Expect(isAsynchronous.getValue() == (HuksTag.HUKS_TAG_IS_ASYNCHRONIZED).getValue())
        let secureKeyAlias = HuksTag.parse(0x400003f1)
        @Expect(secureKeyAlias.getValue() == (HuksTag.HUKS_TAG_SECURE_KEY_ALIAS).getValue())
        let secureKeyUuid = HuksTag.parse(0x500003f2)
        @Expect(secureKeyUuid.getValue() == (HuksTag.HUKS_TAG_SECURE_KEY_UUID).getValue())
        let keyDomain = HuksTag.parse(0x200003f3)
        @Expect(keyDomain.getValue() == (HuksTag.HUKS_TAG_KEY_DOMAIN).getValue())
        let processName = HuksTag.parse(0x50002711)
        @Expect(processName.getValue() == (HuksTag.HUKS_TAG_PROCESS_NAME).getValue())
        let packageName = HuksTag.parse(0x50002712)
        @Expect(packageName.getValue() == (HuksTag.HUKS_TAG_PACKAGE_NAME).getValue())
        let accessTime = HuksTag.parse(0x20002713)
        @Expect(accessTime.getValue() == (HuksTag.HUKS_TAG_ACCESS_TIME).getValue())
        let usesTime = HuksTag.parse(0x20002714)
        @Expect(usesTime.getValue() == (HuksTag.HUKS_TAG_USES_TIME).getValue())
        let cryptoCtx = HuksTag.parse(0x30002715)
        @Expect(cryptoCtx.getValue() == (HuksTag.HUKS_TAG_CRYPTO_CTX).getValue())
        let key = HuksTag.parse(0x50002716)
        @Expect(key.getValue() == (HuksTag.HUKS_TAG_KEY).getValue())
        let keyVersion = HuksTag.parse(0x20002717)
        @Expect(keyVersion.getValue() == (HuksTag.HUKS_TAG_KEY_VERSION).getValue())
        let payloadLen = HuksTag.parse(0x20002718)
        @Expect(payloadLen.getValue() == (HuksTag.HUKS_TAG_PAYLOAD_LEN).getValue())
        let aeTag = HuksTag.parse(0x50002719)
        @Expect(aeTag.getValue() == (HuksTag.HUKS_TAG_AE_TAG).getValue())
        let isKeyHandle = HuksTag.parse(0x3000271a)
        @Expect(isKeyHandle.getValue() == (HuksTag.HUKS_TAG_IS_KEY_HANDLE).getValue())
        let osVersion = HuksTag.parse(0x20002775)
        @Expect(osVersion.getValue() == (HuksTag.HUKS_TAG_OS_VERSION).getValue())
        let osPatchLevel = HuksTag.parse(0x20002776)
        @Expect(osPatchLevel.getValue() == (HuksTag.HUKS_TAG_OS_PATCHLEVEL).getValue())
        let symmetricKeyData = HuksTag.parse(0x50004e21)
        @Expect(symmetricKeyData.getValue() == (HuksTag.HUKS_TAG_SYMMETRIC_KEY_DATA).getValue())
        let asymmetricPublicKeyData = HuksTag.parse(0x50004e22)
        @Expect(asymmetricPublicKeyData.getValue() == (HuksTag.HUKS_TAG_ASYMMETRIC_PUBLIC_KEY_DATA).getValue())
        let asymmetricPrivateKeyData = HuksTag.parse(0x50004e23)
        @Expect(asymmetricPrivateKeyData.getValue() == (HuksTag.HUKS_TAG_ASYMMETRIC_PRIVATE_KEY_DATA).getValue())
    }
}
